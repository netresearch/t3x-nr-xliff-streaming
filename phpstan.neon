# The shared config sets level 10, treatPhpDocTypesAsCertain, the
# strictness flags, the .Build exclude and the curated ergebnis rules
# (allRules: false); phpstan/extension-installer registers phpstan-typo3,
# phpat and the other PHPStan extensions. bleedingEdge is stricter than
# the shared set and stays.
includes:
    - %currentWorkingDirectory%/.Build/vendor/netresearch/typo3-ci-workflows/config/phpstan/phpstan.neon
    - %currentWorkingDirectory%/.Build/vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    paths:
        - Classes
        - Tests

    ignoreErrors:
        # The parser declares `: Generator` and the tests assert it, so PHPStan
        # can prove the assertion true. The assertions stay: they document the
        # streaming contract at the point a reader looks for it, and PHPUnit
        # requires at least one assertion per test. Scoped to Tests/ so the same
        # tautology in production code still fails.
        - identifier: staticMethod.alreadyNarrowedType
          path: %currentWorkingDirectory%/Tests/*
          reportUnmatched: false
